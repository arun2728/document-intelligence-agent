# Interfaze API key — https://interfaze.ai/dashboard
INTERFAZE_API_KEY=sk_your_key_here

# Optional: interfaze-1 (default) or interfaze-1.1-lite
INTERFAZE_MODEL=
# Optional: model for the guardrail call (default interfaze-1.1-lite)
INTERFAZE_GUARD_MODEL=

# Optional: a running `lev serve` endpoint (https://github.com/InterfazeAI/lev).
# When unset, classification falls back to Interfaze structured output.
LEV_BASE_URL=
LEV_API_KEY=

# Spend limits for the public demo (one document run = 4 Interfaze calls).
# Optional: defaults are 40 calls per IP per hour and 400 calls per day overall.
RATE_LIMIT_PER_IP_HOURLY=
RATE_LIMIT_DAILY=

# Optional but recommended in production: Upstash Redis shares the limit counters
# across serverless instances. Adding Upstash from the Vercel Marketplace sets
# KV_REST_API_URL / KV_REST_API_TOKEN automatically; either naming works.
# Without it, counters are per-instance memory (best-effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
